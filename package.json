{
  "name": "agentree-tui",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build --compile --minify src/index.tsx --outfile dist/agentree",
    "install:bin": "bun run build && install -m 755 dist/agentree $HOME/.local/bin/agentree && echo \"installed -> $HOME/.local/bin/agentree\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome ci && tsc --noEmit",
    "coverage": "bun test --timeout 30000 --coverage && bun scripts/check-coverage.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "1.3.14",
    "@types/react": "^19",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.2.8"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
